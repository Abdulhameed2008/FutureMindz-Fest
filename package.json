{
  "name": "gulf2global",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite --host 0.0.0.0",
    "fixtures": "node scripts/fixtures.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "lucide-react": "0.468.0",
    "multer": "2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "24.0.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
